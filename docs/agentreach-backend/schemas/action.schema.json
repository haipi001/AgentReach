{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Action",
  "type": "object",
  "required": [
    "id",
    "entity_id",
    "affordance_id",
    "risk",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "entity_id": {
      "type": "string"
    },
    "affordance_id": {
      "type": "string"
    },
    "risk": {
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3",
        "L4"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "prepared",
        "waiting_approval",
        "running",
        "verifying",
        "completed",
        "failed",
        "rolled_back"
      ]
    },
    "rollback_supported": {
      "type": "boolean"
    }
  }
}
