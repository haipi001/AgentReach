{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RoutineCandidate",
  "type": "object",
  "required": [
    "id",
    "name",
    "observed_count",
    "semantic_steps",
    "confidence"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "observed_count": {
      "type": "integer",
      "minimum": 1
    },
    "semantic_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source_trace_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
