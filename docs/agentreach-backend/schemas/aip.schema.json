{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ApplicationInteractionProfile",
  "type": "object",
  "required": [
    "app_id",
    "version",
    "control_planes",
    "procedures"
  ],
  "properties": {
    "app_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "control_planes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "procedures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
