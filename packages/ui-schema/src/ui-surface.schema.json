{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentreach.local/schemas/ui-surface/v1.json",
  "title": "AgentReach UI Surface",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "surface", "layout", "components"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "surface": { "enum": ["orb", "halo", "workspace"] },
    "layout": { "enum": ["spatial-orbit", "spatial-field", "workspace-grid", "list"] },
    "centerComponent": { "type": ["string", "null"] },
    "components": { "type": "array", "items": { "$ref": "#/$defs/component" } }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "componentId", "zone"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "componentId": { "type": "string", "minLength": 1 },
        "zone": { "enum": ["center", "orbit", "header", "primary", "secondary", "evidence", "footer"] },
        "weight": { "type": "number", "minimum": 0 },
        "visible": { "type": "boolean" },
        "bindings": { "type": "object" },
        "actions": { "type": "array" },
        "visibility": { "type": "object" },
        "props": { "type": "object" }
      }
    }
  }
}
